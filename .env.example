# ==============================================================================
# FoundIt – Smart Campus Lost & Found Platform
# Environment Configuration Template
# ==============================================================================

# Supabase Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Used strictly for server-side administrative tasks)
# NEVER expose this key to client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Allowed Institutional Email Domain (optional restriction)
# e.g., "college.edu" or left empty to allow any registered domain
ALLOWED_EMAIL_DOMAINS=college.edu

